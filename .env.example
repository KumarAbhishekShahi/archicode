# Architecture-as-Code Generator - Environment Configuration Example
# Copy this to .env and customize for your environment

# Application Settings
APP_ENV=development
DEBUG=False
LOG_LEVEL=INFO

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_LOGGER_LEVEL=info

# Database Configuration (Optional)
# For local development, SQLite is used by default
# DATABASE_URL=sqlite:///aac.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@localhost:5432/aac_db
# DATABASE_POOL_SIZE=20

# API Keys (Optional, for future integrations)
# ANTHROPIC_API_KEY=sk-...
# OPENAI_API_KEY=sk-...

# AWS Configuration (if deploying to AWS)
# AWS_REGION=us-east-1
# AWS_PROFILE=default
# AWS_S3_BUCKET=aac-artifacts

# Logging Configuration
# LOG_FORMAT can be: text or json
LOG_FORMAT=text
LOG_FILE=logs/aac.log

# Authentication (Optional, for future)
# AUTH_ENABLED=False
# AUTH_PROVIDER=oauth2
